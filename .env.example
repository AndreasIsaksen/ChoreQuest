# Host binding is independent of the web container's internal port (3000).
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8095
# Generate separate values with: openssl rand -hex 32
SESSION_SECRET=
# Keep true for HTTPS. Set false only for explicit local HTTP/SSH-tunnel use.
SESSION_COOKIE_SECURE=true
# Optional comma-separated trusted proxy IPs/CIDRs; empty means no proxy trust.
TRUST_PROXY=
# These database settings are for the dedicated Compose db service.
DB_HOST=db
DB_PORT=5432
DB_NAME=chorequest
DB_USER=chorequest
DB_PASSWORD=
