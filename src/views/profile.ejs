<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ChoreQuest - Profile</title>
  </head>
  <body>
    <h1><%= user.displayName %>'s Profile</h1>
    <form method="post" action="/logout"><button type="submit">Logout</button></form>

    <h2>Chore Calendar</h2>
    <form method="get" action="/profile">
      <label>
        Filter month
        <input type="month" name="month" value="<%= selectedMonth %>" />
      </label>
      <button type="submit">Apply</button>
    </form>

    <% const days = Object.keys(choresByDate); %>
    <% if (!days.length) { %>
      <p>No chores for selected month.</p>
    <% } %>
    <% days.forEach((day) => { %>
      <h3><%= day %></h3>
      <% choresByDate[day].forEach((chore) => { %>
        <form method="post" action="/chores/<%= chore.id %>/toggle">
          <label>
            <input type="checkbox" onChange="this.form.submit()" <%= chore.completed ? 'checked' : '' %> />
            <strong><%= chore.title %></strong> - <%= chore.description %>
          </label>
        </form>
      <% }); %>
    <% }); %>

    <h2>Request Changes</h2>
    <form method="post" action="/requests">
      <label>
        Related chore
        <select name="choreId">
          <option value="">General request</option>
          <% chores.forEach((chore) => { %>
            <option value="<%= chore.id %>"><%= chore.title %> (<%= chore.due_date %>)</option>
          <% }); %>
        </select>
      </label>
      <br />
      <label>
        Request type
        <select name="requestType" required>
          <option value="different_chore">Different chore</option>
          <option value="due_date_change">Due date change</option>
          <option value="other">Other</option>
        </select>
      </label>
      <br />
      <label>
        Proposed due date
        <input type="date" name="proposedDueDate" />
      </label>
      <br />
      <label>
        Details
        <textarea name="details" required></textarea>
      </label>
      <br />
      <button type="submit">Submit request</button>
    </form>

    <h2>My Requests</h2>
    <% if (!requests.length) { %>
      <p>No requests submitted.</p>
    <% } %>
    <ul>
      <% requests.forEach((request) => { %>
        <li>
          [<%= request.status %>] <%= request.request_type %> - <%= request.details %>
          <% if (request.proposed_due_date) { %>(proposed: <%= request.proposed_due_date %>)<% } %>
          <% if (request.admin_note) { %> | admin note: <%= request.admin_note %><% } %>
        </li>
      <% }); %>
    </ul>
  </body>
</html>
