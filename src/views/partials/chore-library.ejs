<section class="panel form-panel" id="chore-library">
<div class="panel-heading"><div><span class="eyebrow">CREATE ONCE, USE AGAIN</span><h2>Chore library</h2><p class="muted">Your permanent overview. Choose a chore to assign it whenever you need it.</p></div><span class="badge pending"><%= library.length %> saved</span></div>
<details class="decision padded" id="new-chore"><summary>Create a new chore</summary>
<form method="post" action="/admin/chores" class="form-grid">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="wide">Chore name<input name="title" placeholder="e.g. Laundry" maxlength="160" required></label>
<label class="wide">Description (optional)<textarea name="description" rows="2" maxlength="2000" placeholder="What does a job well done look like?"></textarea></label>
<div class="form-footer wide"><p>Save the chore first. Set members and dates in its administration panel.</p><button class="button primary">Save to library</button></div>
</form></details>
<% if(!library.length) { %><p class="padded muted">No saved chores yet. Add your first chore above.</p><% } %>
<div class="library-grid">
<% library.forEach(item=>{ %>
<article class="library-card" id="library-<%= item.id %>"><h3><%= item.title %></h3><p class="muted"><%= item.description || 'Ready to add to your household plan.' %></p>
<details class="decision"><summary>Administer chore</summary>
<form method="post" action="/admin/library/<%= item.id %>/assign" class="stack">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<%- include('assignees',{people:activeUsers,selected:[],multiple:true}) %>
<label>Assignment type<select name="mode"><option value="individual">Individual — separate tasks</option><option value="cooperative">Co-op — shared task</option></select></label>
<p class="form-hint">Individual: each person completes their own task. Co-op: select at least two members; anyone in the group can mark it done for everyone. Leave members empty for an unassigned individual task.</p>
<label>Schedule<select name="schedule" data-schedule><option value="once">One-off task</option><option value="recurring">Recurring completion window</option></select></label>
<label>Start date <span class="optional">(required for recurring chores)</span><input type="date" name="startsOn"></label>
<label data-once>Due date (optional)<input type="date" name="dueDate"></label>
<div class="stack" data-recurring hidden><label>Repeat every<input type="number" name="intervalCount" min="1" max="365" value="1"></label><label>Period<select name="intervalUnit"><option value="days">Days</option><option value="weeks" selected>Weeks</option><option value="months">Months</option></select></label><p class="form-hint">Complete once within each period. New periods appear when they start, with a separate completion record.</p></div>
<button class="button primary">Add to household plan</button>
</form></details>
<details class="decision"><summary>Edit saved chore</summary><form class="stack" method="post" action="/admin/library/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="title" value="<%= item.title %>" maxlength="160" required></label><label>Description<textarea name="description" rows="2" maxlength="2000"><%= item.description %></textarea></label><p class="form-hint">Applies to new assignments. Existing tasks and recurring schedules keep their original details.</p><button class="button subtle">Save details</button></form></details>
</article><% }) %></div></section>
<section class="panel form-panel"><div class="panel-heading"><h2>Recurring schedules</h2></div>
<% if(!series.length) { %><p class="padded muted">Administer a saved chore above to create a recurring schedule.</p><% } %>
<% series.forEach(item=>{ %><details class="decision padded"><summary><%= item.title %> · <%= item.cooperative?'Co-op · ':'' %>Every <%= item.interval_count %> <%= item.interval_count===1?item.interval_unit.slice(0,-1):item.interval_unit %> · <%= item.active?'Active':'Paused' %></summary>
<p class="small muted">Starts <%= formatDate(item.starts_on) %>. Each period is generated when it begins. Previous completions stay in the agenda.</p>
<form class="form-grid" method="post" action="/admin/series/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<%- include('assignees',{people:activeUsers,selected:item.member_ids,multiple:item.cooperative}) %>
<label>Schedule state<select name="active"><option value="true" <%= item.active?'selected':'' %>>Active</option><option value="false" <%= !item.active?'selected':'' %>>Paused</option></select></label><p class="form-hint wide">Changes apply to future periods. Pausing stops new periods; resuming fills missed periods. To change timing or assignment type, pause this schedule and add a new plan from the library.</p><button class="button subtle">Save schedule</button></form></details><% }) %></section>
