<!doctype html>
<html lang="<%= language %>">
<head>
<meta charset="UTF-8">
<script src="/assets/theme.js"></script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t("Welcome back · ChoreQuest") %></title>
<link rel="stylesheet" href="/assets/app.css">
<script src="/assets/app.js" defer></script>
</head>
<body class="login-page">
<main class="login-layout">
<section class="login-story">
<a class="brand" href="/login">
<span class="brand-mark">
<%- include('partials/icon', {name:'home'}) %>
</span>ChoreQuest<span class="brand-dot">.</span>
</a>
<div class="story-copy">
<span class="eyebrow"><%= t("A LITTLE TEAMWORK GOES A LONG WAY") %></span>
<h1><%= t("A happy home.") %><br><%= t("A shared effort.") %></h1>
<p><%= t("Less reminding. More getting things done.") %><br><%= t("Make the everyday a little easier, together.") %></p>
<div class="home-illustration" aria-hidden="true">
<div class="sun">
</div>
<div class="house-roof">
</div>
<div class="house-body">
<div class="house-window">
</div>
<div class="house-door">
</div>
</div>
<div class="plant">
<i>
</i>
<i>
</i>
<i>
</i>
</div>
<div class="floating-task">
<span class="mini-check">✓</span> <%= t("A little progress, every day.") %></div>
</div>
</div>
<p class="story-footer"><%= t("One home. One team.") %></p>
</section>
<section class="login-panel">
<div class="login-form">
<div class="login-actions"><%- include('partials/language-switch') %><%- include('partials/theme-toggle') %></div>
<span class="eyebrow"><%= t("YOUR HOUSEHOLD, IN HARMONY") %></span>
<h2><%= t("Welcome home.") %></h2>
<p class="muted"><%= t("Sign in to see what’s on the agenda.") %></p>
<% if (error) { %>
<div class="alert error" role="alert">
<%= t(error) %>
</div>
<% } %>
<form method="post" action="/login" class="stack">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label><%= t("Username") %><input name="username" autocomplete="username" placeholder="<%= t("Your username") %>" required autofocus>
</label>
<label><%= t("Password") %><input type="password" name="password" autocomplete="current-password" placeholder="<%= t("Enter your password") %>" required>
</label>
<button class="button primary full" type="submit"><%= t("Sign in") %> <%- include('partials/icon', {name:'arrow'}) %>
</button>
</form>
<p class="login-help"><%= t("Need help signing in?") %><br><%= t("Ask your household administrator.") %></p>
<div class="shared-login">
<%- include('partials/icon', {name:'people'}) %>
<span><%= t("One sign-in for the whole household.") %><br><%= t("Your account determines what you can manage.") %></span>
</div>
</div>
<span class="panel-footer"><%= t("Small tasks. A big difference.") %></span>
</section>
</main>
</body>
</html>
