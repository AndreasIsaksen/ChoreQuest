<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>
<%= {overview:'Overview',chores:'Chores',requests:'Requests',household:'Household'}[section] %> · ChoreQuest</title>
<link rel="stylesheet" href="/assets/app.css">
<script src="/assets/app.js" defer>
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app-shell">
<aside class="sidebar">
<a class="brand" href="/dashboard">
<span class="brand-mark">
<%- include('partials/icon',{name:'home'}) %>
</span>ChoreQuest<span class="brand-dot">.</span>
</a>
<div class="household-label">
<span class="household-icon">H</span>
<div>Your household<small>A little better, together</small>
</div>
</div>
<span class="nav-caption">YOUR SPACE</span>
<nav aria-label="Main navigation">
<% for (const [key,label,icon] of [['overview','Overview','grid'],['chores','Chores','list'],['requests','Requests','chat'],...(isAdmin ? [['household','Household','people']] : [])]) { %>
<a href="/dashboard?section=<%= key %>" class="nav-item <%= section === key ? 'active' : '' %>" <%- section === key ? 'aria-current="page"' : '' %>>
<%- include('partials/icon',{name:icon}) %>
<span>
<%= label %>
</span>
<% if (key === 'requests' && stats.pending) { %>
<span class="nav-count">
<%= stats.pending %>
</span>
<% } %>
</a>
<% } %>
</nav>
<div class="sidebar-note">
<%- include('partials/icon',{name:'spark'}) %>
<strong>Every little bit counts.</strong>
<p>Shared chores make more room for the good stuff.</p>
</div>
<div class="account">
<span class="avatar">
<%= user.displayName.slice(0,1).toUpperCase() %>
</span>
<div>
<strong>
<%= user.displayName %>
</strong>
<small>
<%= isAdmin ? 'Household admin' : 'Household member' %>
</small>
</div>
<form action="/logout" method="post">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="icon-button" aria-label="Sign out" title="Sign out">
<%- include('partials/icon',{name:'logout'}) %>
</button>
</form>
</div>
</aside>
<div class="workspace">
<header class="topbar">
<div class="breadcrumb">Your household <span>/</span> <strong>
<%= {overview:'Overview',chores:'Chores',requests:'Requests',household:'Household'}[section] %>
</strong>
</div>
<div class="topbar-date">
<%- include('partials/icon',{name:'calendar'}) %>
<%= formatDate(today) %>
</div>
<span class="role-badge">
<%= isAdmin ? 'Admin' : 'Member' %>
</span>
</header>
<main id="main" class="main">
<% if (flash) { %>
<div class="alert success" role="status">
<%- include('partials/icon',{name:'check'}) %>
<%= flash %>
</div>
<% } %>
<% if (section === 'overview') { %>
<section class="welcome">
<div>
<span class="eyebrow">LET’S MAKE ROOM FOR THE GOOD STUFF</span>
<h1>A little teamwork.<br>A lighter home.</h1>
<p>Welcome back, <%= user.displayName %>. <%= isAdmin ? 'Here’s how your household is doing.' : 'Your next little wins are right here.' %>
</p>
<a class="button primary" href="/dashboard?section=chores<%= isAdmin ? '#new-chore' : '' %>">
<%- include('partials/icon',{name:isAdmin ? 'plus' : 'arrow'}) %>
<%= isAdmin ? 'Assign a chore' : 'View my chores' %>
</a>
</div>
<div class="welcome-art" aria-hidden="true">
<span class="art-star">✳</span>
<div class="art-card">
<span class="art-line">
</span>
<span class="art-check">✓</span>
<span class="art-line short">
</span>
<span class="art-line">
</span>
<span class="art-line short">
</span>
</div>
<span class="art-leaf">
</span>
<span class="art-caption">Better, together.</span>
</div>
</section>
<% } else { %>
<div class="page-heading">
<div>
<span class="eyebrow">YOUR HOUSEHOLD</span>
<h1>
<%= {chores:isAdmin ? 'A plan for everyone.' : 'Your next little wins.', requests:'Let’s work it out.', household:'Meet your home team.'}[section] %>
</h1>
<p class="muted">
<%= {chores:'A clear view of what’s done and what’s next.',requests:'Keep changes and decisions in one place.',household:'Everyone has a part to play.'}[section] %>
</p>
</div>
</div>
<% } %>
<% if (['overview','chores'].includes(section)) { %>
<div class="stats">
<div class="stat">
<span class="stat-icon sage">
<%- include('partials/icon',{name:'list'}) %>
</span>
<div>
<span class="stat-label">Chores to do</span>
<strong>
<%= stats.total-stats.completed %>
</strong>
</div>
<small>Across all dates</small>
</div>
<div class="stat">
<span class="stat-icon peach">
<%- include('partials/icon',{name:'clock'}) %>
</span>
<div>
<span class="stat-label">Overdue</span>
<strong>
<%= stats.overdue %>
</strong>
</div>
<small>A little attention needed</small>
</div>
<div class="stat">
<span class="stat-icon lilac">
<%- include('partials/icon',{name:'check'}) %>
</span>
<div>
<span class="stat-label">Completed</span>
<strong>
<%= stats.completed %>
<em> / <%= stats.total %>
</em>
</strong>
</div>
<small>Every effort adds up</small>
</div>
</div>
<div class="content-grid">
<section class="panel chore-panel">
<div class="panel-heading">
<div>
<span class="eyebrow">
<%= isAdmin ? 'THE HOUSEHOLD PLAN' : 'YOUR PERSONAL PLAN' %>
</span>
<h2>
<%= isAdmin ? 'On the agenda' : 'My chores' %>
</h2>
</div>
<div class="view-switch" aria-label="Chore view">
<a aria-label="List view" class="<%= view==='list'?'selected':'' %>" href="/dashboard?section=chores&view=list&member=<%= member %>&status=<%= status %>">
<%- include('partials/icon',{name:'list'}) %>
</a>
<a aria-label="Calendar view" class="<%= view==='calendar'?'selected':'' %>" href="/dashboard?section=chores&view=calendar&month=<%= selectedMonth %>&member=<%= member %>&status=<%= status %>">
<%- include('partials/icon',{name:'calendar'}) %>
</a>
</div>
</div>
<form class="filters" method="get" action="/dashboard">
<input type="hidden" name="section" value="chores">
<input type="hidden" name="view" value="<%= view %>">
<label>Status<select name="status">
<% for (const [value,label] of [['all','All chores'],['open','To do'],['completed','Completed'],['overdue','Overdue']]) { %>
<option value="<%= value %>" <%= status===value?'selected':'' %>>
<%= label %>
</option>
<% } %>
</select>
</label>
<% if(isAdmin) { %>
<label>Member<select name="member">
<option value="">Everyone</option>
<% users.forEach(person=>{ %>
<option value="<%= person.id %>" <%= member===String(person.id)?'selected':'' %>>
<%= person.display_name %>
</option>
<% }) %>
</select>
</label>
<% } %>
<% if(view==='calendar') { %>
<label>Month<input type="month" name="month" value="<%= selectedMonth %>" required>
</label>
<% } %>
<button class="button subtle" type="submit">Apply filters</button>
</form>
<% if(view==='calendar') { %>
<div class="calendar" aria-label="Chores for <%= selectedMonth %>">
<% ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(day=>{ %>
<div class="weekday">
<%= day %>
</div>
<% }) %>
<% days.forEach(day=>{ const dayChores=chores.filter(c=>c.due_date===day.key); %>
<div class="calendar-day <%= !day.inMonth?'outside':'' %> <%= day.key===today?'today':'' %>">
<time datetime="<%= day.key %>">
<%= day.number %>
</time>
<% dayChores.forEach(c=>{ %>
<a class="calendar-chore <%= c.completed?'done':'' %>" href="#chore-<%= c.id %>" title="<%= c.title %> · <%= c.display_name %>">
<%= c.title %>
</a>
<% }) %>
</div>
<% }) %>
</div>
<h3 class="agenda-label">This month’s agenda</h3>
<% } %>
<% if(!chores.length) { %>
<div class="empty">
<span class="empty-icon">
<%- include('partials/icon',{name:'spark'}) %>
</span>
<h3>
<%= stats.total ? 'A clear view ahead.' : 'A fresh start for your home.' %>
</h3>
<p>
<%= stats.total ? 'No chores match these filters. Try another view.' : isAdmin ? 'Assign the first chore and give everyone a little direction.' : 'Your assigned chores will appear here. Enjoy the breathing room.' %>
</p>
<% if(isAdmin && !stats.total) { %>
<a class="text-link" href="#new-chore">Assign your first chore <span>→</span>
</a>
<% } %>
</div>
<% } %>
<div class="chore-list">
<% chores.forEach(c=>{ const late=!c.completed && c.due_date<today; %>
<article class="chore-row" id="chore-<%= c.id %>">
<% if(c.user_id===user.id) { %>
<form method="post" action="/chores/<%= c.id %>/toggle">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="complete-button <%= c.completed?'checked':'' %>" aria-label="<%= c.completed?'Reopen':'Complete' %> <%= c.title %>" title="<%= c.completed?'Reopen chore':'Mark complete' %>">
<% if(c.completed) { %>
<%- include('partials/icon',{name:'check'}) %>
<% } %>
</button>
</form>
<% } else { %>
<span class="complete-button static <%= c.completed?'checked':'' %>" aria-label="<%= c.completed?'Completed':'Not completed' %>">
<% if(c.completed) { %>
<%- include('partials/icon',{name:'check'}) %>
<% } %>
</span>
<% } %>
<div class="chore-copy">
<h3 class="<%= c.completed?'completed-title':'' %>">
<%= c.title %>
</h3>
<% if(c.description) { %>
<p>
<%= c.description %>
</p>
<% } %>
<div class="chore-meta">
<span>
<%- include('partials/icon',{name:'calendar'}) %>
<%= formatDate(c.due_date) %>
</span>
<% if(isAdmin) { %>
<span class="person-chip">
<span class="tiny-avatar">
<%= c.display_name.slice(0,1) %>
</span>
<%= c.display_name %>
</span>
<% } %>
</div>
</div>
<span class="badge <%= c.completed?'completed':late?'overdue':'pending' %>">
<%= c.completed?'Done':late?'Overdue':c.due_date===today?'Due today':'To do' %>
</span>
</article>
<% }) %>
</div>
</section>
<aside class="right-column">
<section class="panel progress-panel">
<span class="eyebrow">SMALL WINS, SHARED</span>
<h2>
<%= isAdmin?'Household progress':'Your progress' %>
</h2>
<div class="progress-ring" style="--progress:<%= stats.total?Math.round(stats.completed/stats.total*100):0 %>%">
<div>
<strong>
<%= stats.total?Math.round(stats.completed/stats.total*100):0 %>
<span>%</span>
</strong>
<small>complete</small>
</div>
</div>
<p>
<%= stats.total ? `${stats.completed} of ${stats.total} chores completed.` : 'Your next chapter starts with one chore.' %>
</p>
<span class="muted small">A little progress is still progress.</span>
</section>
<section class="request-teaser">
<span class="stat-icon peach">
<%- include('partials/icon',{name:'chat'}) %>
</span>
<h3>A change of plans?</h3>
<p>
<%= isAdmin ? `${stats.pending} pending requests. Help your household find a way forward.` : 'Need a different chore or a little more time? Start a request.' %>
</p>
<a class="text-link" href="/dashboard?section=requests">
<%= isAdmin?'Review requests':'Make a request' %> <span>→</span>
</a>
</section>
</aside>
</div>
<% if(isAdmin) { %>
<details class="panel form-panel" id="new-chore">
<summary>
<span>
<span class="eyebrow">ADMIN TOOLS</span>
<strong>Assign a new chore</strong>
</span>
<span class="summary-plus">+</span>
</summary>
<form method="post" action="/admin/chores" class="form-grid">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>What needs doing?<input name="title" placeholder="e.g. Give the kitchen a fresh start" maxlength="160" required>
</label>
<label>Assign to<select name="userId" required>
<option value="">Choose a household member</option>
<% users.forEach(person=>{ %>
<option value="<%= person.id %>">
<%= person.display_name %>
<%= person.role==='admin'?' (admin)':'' %>
</option>
<% }) %>
</select>
</label>
<label>Due date<input type="date" name="dueDate" required>
</label>
<label class="wide">A little more detail <span class="optional">(optional)</span>
<textarea name="description" rows="3" placeholder="What does a job well done look like?" maxlength="2000">
</textarea>
</label>
<div class="form-footer wide">
<p>Everyone sees their own chores. Admins can see the whole plan.</p>
<button class="button primary">Assign chore <%- include('partials/icon',{name:'arrow'}) %>
</button>
</div>
</form>
</details>
<% } %>
<% } %>
<% if(section==='requests') { %>
<div class="requests-layout">
<section class="panel">
<div class="panel-heading">
<div>
<span class="eyebrow">KEEP THE CONVERSATION GOING</span>
<h2>
<%= isAdmin?'Household requests':'My requests' %>
</h2>
</div>
<span class="badge pending">
<%= stats.pending %> pending</span>
</div>
<% if(!requests.length) { %>
<div class="empty">
<span class="empty-icon">
<%- include('partials/icon',{name:'chat'}) %>
</span>
<h3>All on the same page.</h3>
<p>No requests yet. When plans change, this is where you’ll find them.</p>
</div>
<% } %>
<% requests.forEach(r=>{ %>
<article class="request-card">
<div class="request-title">
<span class="badge <%= r.status==='approved'?'completed':r.status==='rejected'?'overdue':'pending' %>">
<%= r.status %>
</span>
<small>
<%= isAdmin?r.display_name:'Your request' %>
</small>
</div>
<h3>
<%= requestLabels[r.request_type] || r.request_type %>
</h3>
<% if(r.chore_title) { %>
<p class="muted small">For: <%= r.chore_title %>
</p>
<% } %>
<p class="request-details">
<%= r.details %>
</p>
<% if(r.proposed_due_date) { %>
<p class="small">Proposed date: <strong>
<%= formatDate(r.proposed_due_date) %>
</strong>
</p>
<% } %>
<% if(r.admin_note) { %>
<div class="admin-note">
<strong>Admin response</strong>
<p>
<%= r.admin_note %>
</p>
</div>
<% } %>
<% if(isAdmin) { %>
<details class="decision">
<summary>Review request <span>→</span>
</summary>
<form method="post" action="/admin/requests/<%= r.id %>" class="stack">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Decision<select name="status">
<% ['pending','approved','rejected'].forEach(s=>{ %>
<option value="<%= s %>" <%= r.status===s?'selected':'' %>>
<%= s[0].toUpperCase()+s.slice(1) %>
</option>
<% }) %>
</select>
</label>
<label>Approved due date <span class="optional">(optional)</span>
<input type="date" name="approvedDueDate">
</label>
<label>Response <span class="optional">(optional)</span>
<textarea name="adminNote" rows="2">
<%= r.admin_note || '' %>
</textarea>
</label>
<button class="button primary">Save decision</button>
</form>
</details>
<% } %>
</article>
<% }) %>
</section>
<aside>
<section class="panel form-panel">
<div class="panel-heading">
<div>
<span class="eyebrow">LET’S FIND A WAY</span>
<h2>Make a request</h2>
</div>
</div>
<form action="/requests" method="post" class="stack padded">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>What would help?<select name="requestType" required>
<% Object.entries(requestLabels).forEach(([value,label])=>{ %>
<option value="<%= value %>">
<%= label %>
</option>
<% }) %>
</select>
</label>
<label>Related chore<select name="choreId">
<option value="">General request</option>
<% allChores.filter(c=>c.user_id===user.id).forEach(c=>{ %>
<option value="<%= c.id %>">
<%= c.title %>
</option>
<% }) %>
</select>
</label>
<label>Suggested due date <span class="optional">(optional)</span>
<input type="date" name="proposedDueDate">
</label>
<label>Tell us a little more<textarea name="details" rows="4" placeholder="Explain what you’d like to change…" maxlength="2000" required>
</textarea>
</label>
<p class="form-hint">Your chore stays with you until an admin approves a change.</p>
<button class="button primary full">Send request <%- include('partials/icon',{name:'arrow'}) %>
</button>
</form>
</section>
</aside>
</div>
<% } %>
<% if(section==='household' && isAdmin) { %>
<section class="panel">
<div class="panel-heading">
<div>
<span class="eyebrow">ONE HOME. ONE TEAM.</span>
<h2>Your household</h2>
</div>
<span class="badge pending">
<%= users.length %> people</span>
</div>
<div class="members-grid">
<% users.forEach(person=>{ const assigned=allChores.filter(c=>c.user_id===person.id); %>
<article class="member-card">
<span class="avatar large">
<%= person.display_name.slice(0,1) %>
</span>
<h3>
<%= person.display_name %>
</h3>
<p class="muted small">
<%= person.role==='admin'?'Household admin':'Household member' %>
</p>
<div class="member-stats">
<strong>
<%= assigned.filter(c=>!c.completed).length %> <span>to do</span>
</strong>
<strong>
<%= assigned.filter(c=>c.completed).length %> <span>done</span>
</strong>
</div>
<a class="text-link" href="/dashboard?section=chores&member=<%= person.id %>">View chores <span>→</span>
</a>
</article>
<% }) %>
</div>
</section>
<% } %>
<footer class="main-footer">
<span>ChoreQuest<span class="brand-dot">.</span>
</span>
<span>Less chasing. More living.</span>
</footer>
</main>
</div>
</div>
</body>
</html>
