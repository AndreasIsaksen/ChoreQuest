<!doctype html>
<html lang="<%= language %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>
<%= t({overview:'Overview',chores:'Chores',requests:'Requests',household:'Household'}[section]) %> · ChoreQuest</title>
<link rel="stylesheet" href="/assets/app.css">
<script src="/assets/app.js" defer>
</script>
</head>
<body>
<a class="skip-link" href="#main"><%= t("Skip to content") %></a>
<div class="app-shell">
<aside class="sidebar">
<a class="brand" href="/dashboard">
<span class="brand-mark">
<%- include('partials/icon',{name:'home'}) %>
</span>ChoreQuest<span class="brand-dot">.</span>
</a>
<div class="household-label">
<span class="household-icon">H</span>
<div><%= t("Your household") %><small><%= t("A little better, together") %></small>
</div>
</div>
<span class="nav-caption"><%= t("YOUR SPACE") %></span>
<nav aria-label="<%= t("Main navigation") %>">
<% for (const [key,label,icon] of [['overview','Overview','grid'],['chores','Chores','list'],['requests','Requests','chat'],...(isAdmin ? [['household','Household','people']] : [])]) { %>
<a href="/dashboard?section=<%= key %>" class="nav-item <%= section === key ? 'active' : '' %>" <%- section === key ? 'aria-current="page"' : '' %>>
<%- include('partials/icon',{name:icon}) %>
<span>
<%= t(label) %>
</span>
<% if (key === 'requests' && stats.pending) { %>
<span class="nav-count">
<%= stats.pending %>
</span>
<% } %>
</a>
<% } %>
</nav>
<div class="sidebar-note">
<%- include('partials/icon',{name:'spark'}) %>
<strong><%= t("Every little bit counts.") %></strong>
<p><%= t("Shared chores make more room for the good stuff.") %></p>
</div>
<div class="account">
<span class="avatar">
<%= user.displayName.slice(0,1).toUpperCase() %>
</span>
<div>
<strong>
<%= user.displayName %>
</strong>
<small>
<%= t(isAdmin ? 'Household admin' : 'Household member') %>
</small>
</div>
<form action="/logout" method="post">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="icon-button" aria-label="<%= t("Sign out") %>" title="<%= t("Sign out") %>">
<%- include('partials/icon',{name:'logout'}) %>
</button>
</form>
</div>
</aside>
<div class="workspace">
<header class="topbar">
<%- include('partials/language-switch') %>
<div class="breadcrumb"><%= t("Your household") %> <span>/</span> <strong>
<%= t({overview:'Overview',chores:'Chores',requests:'Requests',household:'Household'}[section]) %>
</strong>
</div>
<div class="topbar-date">
<%- include('partials/icon',{name:'calendar'}) %>
<%= formatDate(today) %>
</div>
<span class="role-badge">
<%= t(isAdmin ? 'Admin' : 'Member') %>
</span>
</header>
<main id="main" class="main">
<% if (flash) { %>
<div class="alert success" role="status">
<%- include('partials/icon',{name:'check'}) %>
<%= t(flash) %>
</div>
<% } %>
<% if (section === 'overview') { %>
<section class="welcome">
<div>
<span class="eyebrow"><%= t("LET’S MAKE ROOM FOR THE GOOD STUFF") %></span>
<h1><%= t("A little teamwork.") %><br><%= t("A lighter home.") %></h1>
<p><%= t("Welcome back,") %> <%= user.displayName %>. <%= t(isAdmin ? 'Here’s how your household is doing.' : 'Your next little wins are right here.') %>
</p>
<a class="button primary" href="/dashboard?section=chores<%= isAdmin ? '#new-chore' : '' %>">
<%- include('partials/icon',{name:isAdmin ? 'plus' : 'arrow'}) %>
<%= t(isAdmin ? 'Create a chore' : 'View my chores') %>
</a>
</div>
<div class="welcome-art" aria-hidden="true">
<span class="art-star">✳</span>
<div class="art-card">
<span class="art-line">
</span>
<span class="art-check">✓</span>
<span class="art-line short">
</span>
<span class="art-line">
</span>
<span class="art-line short">
</span>
</div>
<span class="art-leaf">
</span>
<span class="art-caption"><%= t("Better, together.") %></span>
</div>
</section>
<% } else { %>
<div class="page-heading">
<div>
<span class="eyebrow"><%= t("YOUR HOUSEHOLD") %></span>
<h1>
<%= t({chores:isAdmin ? 'A plan for everyone.' : 'Your next little wins.', requests:'Let’s work it out.', household:'Meet your home team.'}[section]) %>
</h1>
<p class="muted">
<%= t({chores:'A clear view of what’s done and what’s next.',requests:'Keep changes and decisions in one place.',household:'Everyone has a part to play.'}[section]) %>
</p>
</div>
</div>
<% } %>
<% if (['overview','chores'].includes(section)) { %>
<% if(isAdmin) { %><nav class="chore-shortcuts" aria-label="<%= t("Chore administration") %>"><a class="button subtle" href="#chore-library"><%= t("Chore library") %></a><a class="button subtle" href="#household-plan"><%= t("Household plan") %></a><a class="button subtle" href="#new-chore"><%= t("Create chore") %></a></nav><% } %>
<section class="panel padded" aria-label="<%= t("Your points") %>"><h2><%= t("Your points") %></h2><p><strong><%= pointBalance.weekly_points %></strong> <%= t("this week ·") %> <strong><%= pointBalance.permanent_points %></strong> <%= t("permanent points") %></p><p class="muted small"><%= t("Weekly points transfer every Monday at midnight (Europe/Oslo). Missed deadlines deduct the chore value, even below zero.") %></p></section>
<div class="stats">
<div class="stat">
<span class="stat-icon sage">
<%- include('partials/icon',{name:'list'}) %>
</span>
<div>
<span class="stat-label"><%= t("Chores to do") %></span>
<strong>
<%= stats.total-stats.completed %>
</strong>
</div>
<small><%= t("Across all dates") %></small>
</div>
<div class="stat">
<span class="stat-icon peach">
<%- include('partials/icon',{name:'clock'}) %>
</span>
<div>
<span class="stat-label"><%= t("Overdue") %></span>
<strong>
<%= stats.overdue %>
</strong>
</div>
<small><%= t("A little attention needed") %></small>
</div>
<div class="stat">
<span class="stat-icon lilac">
<%- include('partials/icon',{name:'check'}) %>
</span>
<div>
<span class="stat-label"><%= t("Completed") %></span>
<strong>
<%= stats.completed %>
<em> / <%= stats.total %>
</em>
</strong>
</div>
<small><%= t("Every effort adds up") %></small>
</div>
</div>
<div class="content-grid">
<section class="panel chore-panel" id="household-plan">
<div class="panel-heading">
<div>
<span class="eyebrow">
<%= t(isAdmin ? 'THE HOUSEHOLD PLAN' : 'YOUR PERSONAL PLAN') %>
</span>
<h2>
<%= t(isAdmin ? 'On the agenda' : 'My chores') %>
</h2>
</div>
<div class="view-switch" aria-label="<%= t("Chore view") %>">
<a aria-label="<%= t("List view") %>" class="<%= view==='list'?'selected':'' %>" href="/dashboard?section=chores&view=list&member=<%= member %>&status=<%= status %>">
<%- include('partials/icon',{name:'list'}) %>
</a>
<a aria-label="<%= t("Calendar view") %>" class="<%= view==='calendar'?'selected':'' %>" href="/dashboard?section=chores&view=calendar&month=<%= selectedMonth %>&member=<%= member %>&status=<%= status %>">
<%- include('partials/icon',{name:'calendar'}) %>
</a>
</div>
</div>
<form class="filters" method="get" action="/dashboard">
<input type="hidden" name="section" value="chores">
<input type="hidden" name="view" value="<%= view %>">
<label><%= t("Status") %><select name="status">
<% for (const [value,label] of [['all','All chores'],['open','To do'],['completed','Completed'],['overdue','Overdue']]) { %>
<option value="<%= value %>" <%= status===value?'selected':'' %>>
<%= t(label) %>
</option>
<% } %>
</select>
</label>
<% if(isAdmin) { %>
<label><%= t("Member") %><select name="member">
<option value=""><%= t("Everyone") %></option><option value="unassigned" <%= member==='unassigned'?'selected':'' %>><%= t("Unassigned") %></option>
<% users.forEach(person=>{ %>
<option value="<%= person.id %>" <%= member===String(person.id)?'selected':'' %>>
<%= person.display_name %>
</option>
<% }) %>
</select>
</label>
<% } %>
<% if(view==='calendar') { %>
<label><%= t("Month") %><input type="month" name="month" value="<%= selectedMonth %>" required>
</label>
<% } %>
<button class="button subtle" type="submit"><%= t("Apply filters") %></button>
</form>
<% if(view==='calendar') { %>
<div class="calendar" aria-label="<%= t('Chores for {month}', {month:selectedMonth}) %>">
<% ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(day=>{ %>
<div class="weekday">
<%= t(day) %>
</div>
<% }) %>
<% days.forEach(day=>{ const dayChores=chores.filter(c=>day.inMonth && (c.window_start ? day.key>=c.window_start && day.key<=c.due_date : c.due_date===day.key)); %>
<div class="calendar-day <%= !day.inMonth?'outside':'' %> <%= day.key===today?'today':'' %>">
<time datetime="<%= day.key %>">
<%= day.number %>
</time>
<% dayChores.forEach(c=>{ %>
<a class="calendar-chore <%= c.completed?'done':'' %>" href="#chore-<%= c.id %>" title="<%= c.title %> · <%= c.display_name %>">
<%= c.title %>
</a>
<% }) %>
</div>
<% }) %>
</div>
<h3 class="agenda-label"><%= t("This month’s agenda") %></h3>
<% } %>
<% if(!chores.length) { %>
<div class="empty">
<span class="empty-icon">
<%- include('partials/icon',{name:'spark'}) %>
</span>
<h3>
<%= t(stats.total ? 'A clear view ahead.' : 'A fresh start for your home.') %>
</h3>
<p>
<%= t(stats.total ? 'No chores match these filters. Try another view.' : isAdmin ? 'Assign the first chore and give everyone a little direction.' : 'Your assigned chores will appear here. Enjoy the breathing room.') %>
</p>
<% if(isAdmin && !stats.total) { %>
<a class="text-link" href="#new-chore"><%= t("Create your first chore") %> <span>→</span>
</a>
<% } %>
</div>
<% } %>
<div class="chore-list">
<% chores.forEach(c=>{ const late=!c.completed && c.due_date && c.due_date<today; %>
<article class="chore-row" id="chore-<%= c.id %>">
<% if(c.member_ids.includes(user.id)) { %>
<form method="post" action="/chores/<%= c.id %>/toggle">
<input type="hidden" name="completed" value="<%= !c.completed %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button <%= c.window_start && c.window_start>today ? 'disabled' : '' %> class="complete-button <%= c.completed?'checked':'' %>" aria-label="<%= t(c.completed?'Reopen':'Complete') %> <%= c.title %>" title="<%= t(c.completed?'Reopen chore':'Mark complete') %>">
<% if(c.completed) { %>
<%- include('partials/icon',{name:'check'}) %>
<% } %>
</button>
</form>
<% } else { %>
<span class="complete-button static <%= c.completed?'checked':'' %>" aria-label="<%= t(c.completed?'Completed':'Not completed') %>">
<% if(c.completed) { %>
<%- include('partials/icon',{name:'check'}) %>
<% } %>
</span>
<% } %>
<div class="chore-copy">
<h3 class="<%= c.completed?'completed-title':'' %>">
<%= c.title %>
</h3><span class="badge pending"><%= c.points %> <%= t("points") %></span>
<% if(c.description) { %>
<p>
<%= c.description %>
</p>
<% } %>
<% if(c.cooperative) { %><p class="coop-label"><%= t("Co-op chore · Shared completion") %></p><% } %>
<div class="chore-meta">
<span>
<%- include('partials/icon',{name:'calendar'}) %>
<%= c.window_start ? formatDate(c.window_start) + ' – ' : '' %><%= c.due_date ? formatDate(c.due_date) : t('No deadline') %><%= t(c.series_id ? ' · Once per period' : '') %>
</span>
<% if(isAdmin || c.cooperative) { %>
<span class="person-chip">
<span class="tiny-avatar">
<%= c.display_name.slice(0,1) %>
</span>
<%= c.display_name %>
</span>
<% } %>
</div>
<% if(isAdmin && !c.completed) { %><details class="decision"><summary><%= t("Manage assignment") %></summary><form method="post" action="/admin/chores/<%= c.id %>/assign" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<%- include('partials/assignees',{people:activeUsers,selected:c.member_ids,multiple:c.cooperative}) %>
<button class="button subtle"><%= t("Save assignment") %></button><p class="form-hint"><%= t("Changes this task only. Co-op completion is shared by all participants.") %></p></form></details><% } %>
</div>
<span class="badge <%= c.completed?'completed':late?'overdue':'pending' %>">
<%= t(c.completed?(c.completed_late?'Done late':'Done'):late?'Overdue':c.due_date===today?'Due today':'To do') %>
</span>
</article>
<% }) %>
</div>
</section>
<aside class="right-column">
<section class="panel progress-panel">
<span class="eyebrow"><%= t("SMALL WINS, SHARED") %></span>
<h2>
<%= t(isAdmin?'Household progress':'Your progress') %>
</h2>
<div class="progress-ring" style="--progress:<%= stats.total?Math.round(stats.completed/stats.total*100):0 %>%">
<div>
<strong>
<%= stats.total?Math.round(stats.completed/stats.total*100):0 %>
<span>%</span>
</strong>
<small><%= t("complete") %></small>
</div>
</div>
<p>
<%= stats.total ? t('{completed} of {total} chores completed.', {completed:stats.completed,total:stats.total}) : t('Your next chapter starts with one chore.') %>
</p>
<span class="muted small"><%= t("A little progress is still progress.") %></span>
</section>
<section class="request-teaser">
<span class="stat-icon peach">
<%- include('partials/icon',{name:'chat'}) %>
</span>
<h3><%= t("A change of plans?") %></h3>
<p>
<%= isAdmin ? t('{count} pending requests. Help your household find a way forward.', {count:stats.pending}) : t('Need a different chore or a little more time? Start a request.') %>
</p>
<a class="text-link" href="/dashboard?section=requests">
<%= t(isAdmin?'Review requests':'Make a request') %> <span>→</span>
</a>
</section>
</aside>
</div>
<% if(isAdmin) { %>
<%- include('partials/chore-library') %>
<% } %>
<% } %>
<% if(section==='requests') { %>
<div class="requests-layout">
<section class="panel">
<div class="panel-heading">
<div>
<span class="eyebrow"><%= t("KEEP THE CONVERSATION GOING") %></span>
<h2>
<%= t(isAdmin?'Household requests':'My requests') %>
</h2>
</div>
<span class="badge pending">
<%= stats.pending %> <%= t("pending") %></span>
</div>
<% if(!requests.length) { %>
<div class="empty">
<span class="empty-icon">
<%- include('partials/icon',{name:'chat'}) %>
</span>
<h3><%= t("All on the same page.") %></h3>
<p><%= t("No requests yet. When plans change, this is where you’ll find them.") %></p>
</div>
<% } %>
<% requests.forEach(r=>{ %>
<article class="request-card">
<div class="request-title">
<span class="badge <%= r.status==='approved'?'completed':r.status==='rejected'?'overdue':'pending' %>">
<%= t(r.status) %>
</span>
<small>
<%= isAdmin?r.display_name:t('Your request') %>
</small>
</div>
<h3>
<%= t(requestLabels[r.request_type] || r.request_type) %>
</h3>
<% if(r.chore_title) { %>
<p class="muted small"><%= t("For:") %> <%= r.chore_title %>
</p>
<% } %>
<p class="request-details">
<%= r.details %>
</p>
<% if(r.proposed_due_date) { %>
<p class="small"><%= t("Proposed date:") %> <strong>
<%= formatDate(r.proposed_due_date) %>
</strong>
</p>
<% } %>
<% if(r.admin_note) { %>
<div class="admin-note">
<strong><%= t("Admin response") %></strong>
<p>
<%= r.admin_note %>
</p>
</div>
<% } %>
<% if(isAdmin) { %>
<details class="decision">
<summary><%= t("Review request") %> <span>→</span>
</summary>
<form method="post" action="/admin/requests/<%= r.id %>" class="stack">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label><%= t("Decision") %><select name="status">
<% ['pending','approved','rejected'].forEach(s=>{ %>
<option value="<%= s %>" <%= r.status===s?'selected':'' %>>
<%= t(s[0].toUpperCase()+s.slice(1)) %>
</option>
<% }) %>
</select>
</label>
<label><%= t("Approved due date") %> <span class="optional"><%= t("(optional)") %></span>
<input type="date" name="approvedDueDate">
</label>
<label><%= t("Response") %> <span class="optional"><%= t("(optional)") %></span>
<textarea name="adminNote" rows="2">
<%= r.admin_note || '' %>
</textarea>
</label>
<button class="button primary"><%= t("Save decision") %></button>
</form>
</details>
<% } %>
</article>
<% }) %>
</section>
<aside>
<section class="panel form-panel">
<div class="panel-heading">
<div>
<span class="eyebrow"><%= t("LET’S FIND A WAY") %></span>
<h2><%= t("Make a request") %></h2>
</div>
</div>
<form action="/requests" method="post" class="stack padded">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label><%= t("What would help?") %><select name="requestType" required>
<% Object.entries(requestLabels).forEach(([value,label])=>{ %>
<option value="<%= value %>">
<%= t(label) %>
</option>
<% }) %>
</select>
</label>
<label><%= t("Related chore") %><select name="choreId">
<option value=""><%= t("General request") %></option>
<% allChores.filter(c=>c.member_ids.includes(user.id)).forEach(c=>{ %>
<option value="<%= c.id %>">
<%= c.title %>
</option>
<% }) %>
</select>
</label>
<label><%= t("Suggested due date") %> <span class="optional"><%= t("(optional)") %></span>
<input type="date" name="proposedDueDate">
</label>
<label><%= t("Tell us a little more") %><textarea name="details" rows="4" placeholder="<%= t("Explain what you’d like to change…") %>" maxlength="2000" required>
</textarea>
</label>
<p class="form-hint"><%= t("Your chore stays with you until an admin approves a change.") %></p>
<button class="button primary full"><%= t("Send request") %> <%- include('partials/icon',{name:'arrow'}) %>
</button>
</form>
</section>
</aside>
</div>
<% } %>
<% if(section==='household' && isAdmin) { %>
<section class="panel"><div class="panel-heading"><h2><%= t("Household accounts") %></h2><span class="badge pending"><%= activeUsers.length %> <%= t("active") %></span></div><div class="members-grid">
<% users.forEach(person=>{ %><article class="member-card"><span class="avatar large"><%= person.display_name.slice(0,1) %></span><h3><%= person.display_name %></h3><p class="muted small">@<%= person.username %> · <%= t(person.role) %><%= t(person.deleted_at?' · Removed':'') %></p>
<% if(!person.deleted_at) { %><a class="text-link" href="/dashboard?section=chores&member=<%= person.id %>"><%= t("View chores →") %></a>
<p><strong><%= person.weekly_points %></strong> <%= t("weekly ·") %> <strong><%= person.permanent_points %></strong> <%= t("permanent points") %></p><details class="decision"><summary><%= t("Edit account") %></summary><form class="stack" method="post" action="/admin/users/<%= person.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="save"><label><%= t("Display name") %><input name="displayName" value="<%= person.display_name %>" maxlength="80" required></label><label><%= t("Role") %><select name="role"><option value="member" <%= person.role==='member'?'selected':'' %>><%= t("Member") %></option><option value="admin" <%= person.role==='admin'?'selected':'' %>><%= t("Admin") %></option></select></label><label><%= t("New password (optional)") %><input type="password" name="password" autocomplete="new-password" minlength="12" placeholder="<%= t("Leave blank to keep password") %>"></label><p class="form-hint"><%= t("Saving revokes this account’s existing sessions.") %></p><button class="button primary"><%= t("Save account") %></button></form></details>
<% if(person.id!==user.id) { %><details class="decision"><summary><%= t("Remove account") %></summary><p class="small"><%= t("Sign-in access is revoked immediately. Current unfinished chores and future periods become unassigned. Completed and overdue history is preserved. You can restore the account later.") %></p><form method="post" action="/admin/users/<%= person.id %>" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="remove"><label><%= t('Type {username} to confirm', {username:person.username}) %><input name="confirmUsername" autocomplete="off" required></label><button class="button subtle"><%= t("Remove account") %></button></form></details><% } %>
<% } else { %><form method="post" action="/admin/users/<%= person.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="restore"><button class="button subtle"><%= t("Restore account") %></button></form><% } %></article><% }) %></div></section>
<section class="panel form-panel"><div class="panel-heading"><h2><%= t("Create an account") %></h2></div><form class="form-grid" method="post" action="/admin/users"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><%= t("Display name") %><input name="displayName" maxlength="80" required autocomplete="off"></label><label><%= t("Username") %><input name="username" pattern="[a-zA-Z0-9_.-]+" maxlength="40" required autocomplete="off"></label><label><%= t("Password") %><input name="password" type="password" minlength="12" required autocomplete="new-password"></label><label><%= t("Role") %><select name="role"><option value="member"><%= t("Member") %></option><option value="admin"><%= t("Admin") %></option></select></label><p class="form-hint wide"><%= t("Use at least 12 characters (maximum 72 bytes). Share the password privately. Admins can manage chores and other accounts.") %></p><button class="button primary"><%= t("Create account") %></button></form></section>
<% } %>
<footer class="main-footer">
<span>ChoreQuest<span class="brand-dot">.</span>
</span>
<span><%= t("Less chasing. More living.") %></span>
</footer>
</main>
</div>
</div>
</body>
</html>
